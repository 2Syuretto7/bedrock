# Postgres connection string. On Vercel this is injected by the Neon integration.
DATABASE_URL=postgres://bedrock:bedrock@localhost:5432/bedrock_dev

# The tutor, and the writer of review questions. On Vercel the key is set in the project's environment variables; tests never need it.
